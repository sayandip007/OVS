// ============================================================================
// Online Voting System (OVS) — Production-Grade Prisma Schema
// Authoritative Schema: backend/prisma/schema.prisma (Promoted in Phase 8.2)
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================================
// ENUMS (17 Enums)
// ============================================================================

enum JurisdictionType {
  STATE
  UNION_TERRITORY
}

enum MetadataSource {
  VERIFIED_OFFICIAL
  DEMO_SAMPLE
}

enum ReservationType {
  GENERAL
  SC
  ST
}

enum UserType {
  VOTER
  ADMIN
}

enum ElectionType {
  LOK_SABHA
  STATE_ASSEMBLY
}

enum ConstituencyType {
  PARLIAMENTARY
  ASSEMBLY
}

enum ElectionStatus {
  DRAFT
  UPCOMING
  NOMINATION_OPEN
  NOMINATION_CLOSED
  READY
  POLLING_ACTIVE
  POLLING_COMPLETED
  COUNTING
  RESULTS_DECLARED
  CANCELLED
  ARCHIVED
}

enum ParticipationStatus {
  PENDING
  VOTED
  UPCOMING
  CLOSED
  NOT_ELIGIBLE
}

enum CandidateNominationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
  SUSPENDED
  ARCHIVED
}

enum PartyType {
  NATIONAL
  STATE
  INDEPENDENT
}

enum PartyStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AdminRole {
  SUPER_ADMIN
  NATIONAL_ADMIN
  STATE_ADMIN
  ELECTION_OFFICER
  READ_ONLY_AUDITOR
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum ResultStatus {
  DRAFT
  COUNTING_IN_PROGRESS
  COUNTING_PAUSED
  COUNTING_COMPLETED
  RESULT_READY_FOR_REVIEW
  PUBLISHED
  TIED
  UNDER_REVIEW
  CORRECTED
  UNPUBLISHED
}

enum AnnouncementCategory {
  GENERAL_INFO
  ELECTION_SCHEDULE
  CANDIDATE_INFO
  POLLING_INSTRUCTIONS
  RESULTS
  IMPORTANT_NOTICE
}

enum AnnouncementAudience {
  ALL_VOTERS
  SPECIFIC_STATE
  SPECIFIC_ELECTION
  SPECIFIC_CONSTITUENCY
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  ELECTION_ANNOUNCEMENT
  NOMINATION_SCHEDULE
  POLLING_SCHEDULE
  ELECTION_REMINDER
  CANDIDATE_LIST
  RESULT_PUBLISHED
  PROFILE_UPDATE
  GENERAL_ANNOUNCEMENT
}

// ============================================================================
// GEOGRAPHY MODELS (Models 1–4)
// ============================================================================

model State {
  id                   String           @id @db.VarChar(10) // e.g. "WB", "MH", "DL"
  name                 String           @db.VarChar(100)
  type                 JurisdictionType @default(STATE)
  capital              String           @db.VarChar(100)
  officialLanguages    String[]         @map("official_languages")
  totalLokSabhaSeats   Int              @map("total_lok_sabha_seats")
  totalAssemblySeats   Int              @map("total_assembly_seats")
  metadataSource       MetadataSource   @default(VERIFIED_OFFICIAL) @map("metadata_source")
  createdAt            DateTime         @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt            DateTime         @updatedAt @db.Timestamptz(6) @map("updated_at")

  districts            District[]
  parliamentarySeats   ParliamentaryConstituency[]
  assemblySeats        AssemblyConstituency[]
  elections            Election[]
  voterProfiles        VoterProfile[]
  adminUsers           AdminUser[]
  adminStateScopes     AdminStateScope[]
  announcements        Announcement[]

  @@map("states")
}

model District {
  id              String         @id @db.VarChar(50) // e.g. "DIST-WB-KOL"
  stateId         String         @db.VarChar(10) @map("state_id")
  name            String         @db.VarChar(100)
  headquarters    String         @db.VarChar(100)
  metadataSource  MetadataSource @default(VERIFIED_OFFICIAL) @map("metadata_source")
  createdAt       DateTime       @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6) @map("updated_at")

  state           State          @relation(fields: [stateId], references: [id], onDelete: Restrict)
  assemblySeats   AssemblyConstituency[]
  voterProfiles   VoterProfile[]

  @@unique([id, stateId]) // Composite key for geographic hierarchy integrity
  @@index([stateId])
  @@map("districts")
}

model ParliamentaryConstituency {
  id                 String           @id @db.VarChar(50) // e.g. "PC-WB-KOLKATA-SOUTH"
  stateId            String           @db.VarChar(10) @map("state_id")
  constituencyNumber Int              @map("constituency_number")
  name               String           @db.VarChar(150)
  reservationType    ReservationType  @default(GENERAL) @map("reservation_type")
  totalVoters        Int              @default(0) @map("total_voters")
  metadataSource     MetadataSource   @default(VERIFIED_OFFICIAL) @map("metadata_source")
  createdAt          DateTime         @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt          DateTime         @updatedAt @db.Timestamptz(6) @map("updated_at")

  state              State            @relation(fields: [stateId], references: [id], onDelete: Restrict)
  childAssemblySeats AssemblyConstituency[]
  voterProfiles      VoterProfile[]
  electionMappings   ElectionConstituency[]
  nominations              CandidateNomination[]
  countingSessions         CountingSession[]
  targetAnnouncements      Announcement[]
  adminConstituencyScopes  AdminConstituencyScope[]

  @@unique([id, stateId]) // Composite key for geographic hierarchy integrity
  @@unique([stateId, constituencyNumber])
  @@index([stateId])
  @@map("parliamentary_constituencies")
}

model AssemblyConstituency {
  id                                String                    @id @db.VarChar(50) // e.g. "AC-WB-BHABANIPUR"
  stateId                           String                    @db.VarChar(10) @map("state_id")
  districtId                        String                    @db.VarChar(50) @map("district_id")
  parentParliamentaryConstituencyId String                    @db.VarChar(50) @map("parent_parliamentary_constituency_id")
  constituencyNumber                Int                       @map("constituency_number")
  name                              String                    @db.VarChar(150)
  reservationType                   ReservationType           @default(GENERAL) @map("reservation_type")
  totalVoters                       Int                       @default(0) @map("total_voters")
  metadataSource                    MetadataSource            @default(VERIFIED_OFFICIAL) @map("metadata_source")
  createdAt                         DateTime                  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                         DateTime                  @updatedAt @db.Timestamptz(6) @map("updated_at")

  state                             State                     @relation(fields: [stateId], references: [id], onDelete: Restrict)
  district                          District                  @relation(fields: [districtId, stateId], references: [id, stateId], onDelete: Restrict)
  parentParliamentary               ParliamentaryConstituency @relation(fields: [parentParliamentaryConstituencyId, stateId], references: [id, stateId], onDelete: Restrict)
  voterProfiles                     VoterProfile[]
  electionMappings                  ElectionConstituency[]
  nominations                       CandidateNomination[]
  countingSessions                  CountingSession[]
  targetAnnouncements               Announcement[]
  adminConstituencyScopes           AdminConstituencyScope[]

  @@unique([id, stateId]) // Composite key for state integrity
  @@unique([id, parentParliamentaryConstituencyId]) // Inherent dual-mapping integrity key
  @@unique([stateId, constituencyNumber])
  @@index([stateId])
  @@index([districtId])
  @@index([parentParliamentaryConstituencyId])
  @@map("assembly_constituencies")
}

// ============================================================================
// USER, AUTHENTICATION & VOTER MODELS (Models 5–8)
// ============================================================================

model User {
  id                  String        @id @default(uuid()) @db.Uuid
  userType            UserType      @default(VOTER) @map("user_type")
  identifier          String        @unique @db.VarChar(100) // EPIC or Officer Code
  passwordHash        String        @db.VarChar(255) @map("password_hash") // Argon2id hash
  isActive            Boolean       @default(true) @map("is_active")
  failedLoginAttempts Int           @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime?     @db.Timestamptz(6) @map("lockout_until")
  lastLoginAt         DateTime?     @db.Timestamptz(6) @map("last_login_at")
  createdAt           DateTime      @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime      @updatedAt @db.Timestamptz(6) @map("updated_at")

  voterProfile        VoterProfile?
  adminUser           AdminUser?
  sessions            UserSession[]

  @@map("users")
}

model VoterProfile {
  id                          String                    @id @default(uuid()) @db.Uuid
  userId                      String                    @unique @db.Uuid @map("user_id")
  epicNumber                  String                    @unique @db.VarChar(20) @map("epic_number")
  fullName                    String                    @db.VarChar(150) @map("full_name")
  dateOfBirth                 DateTime                  @db.Date @map("date_of_birth")
  gender                      String                    @db.VarChar(20)
  mobile                      String                    @db.VarChar(15)
  email                       String                    @db.VarChar(255)
  address                     String                    @db.Text
  pinCode                     String                    @db.VarChar(10) @map("pin_code")
  stateId                     String                    @db.VarChar(10) @map("state_id")
  districtId                  String                    @db.VarChar(50) @map("district_id")
  parliamentaryConstituencyId String                    @db.VarChar(50) @map("parliamentary_constituency_id")
  assemblyConstituencyId      String                    @db.VarChar(50) @map("assembly_constituency_id")
  registrationDate            DateTime                  @default(now()) @db.Timestamptz(6) @map("registration_date")
  isVerified                  Boolean                   @default(true) @map("is_verified")
  metadataSource              MetadataSource            @default(DEMO_SAMPLE) @map("metadata_source")
  createdAt                   DateTime                  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                   DateTime                  @updatedAt @db.Timestamptz(6) @map("updated_at")

  user                        User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  state                       State                     @relation(fields: [stateId], references: [id], onDelete: Restrict)
  district                    District                  @relation(fields: [districtId, stateId], references: [id, stateId], onDelete: Restrict)
  parliamentaryConstituency   ParliamentaryConstituency @relation(fields: [parliamentaryConstituencyId, stateId], references: [id, stateId], onDelete: Restrict)
  assemblyConstituency        AssemblyConstituency      @relation(fields: [assemblyConstituencyId, parliamentaryConstituencyId], references: [id, parentParliamentaryConstituencyId], onDelete: Restrict)
  participations              DemoParticipation[]
  notifications               VoterNotification[]

  @@index([stateId, parliamentaryConstituencyId, assemblyConstituencyId])
  @@map("voter_profiles")
}

model UserSession {
  id             String   @id @db.VarChar(128)
  userId         String   @db.Uuid @map("user_id")
  userAgent      String?  @db.Text @map("user_agent")
  ipAddress      String?  @db.VarChar(45) @map("ip_address")
  lastActivityAt DateTime @default(now()) @db.Timestamptz(6) @map("last_activity_at")
  expiresAt      DateTime @db.Timestamptz(6) @map("expires_at")
  createdAt      DateTime @default(now()) @db.Timestamptz(6) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model AuthChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  identifier  String    @db.VarChar(100) // Target EPIC or Officer Code
  otpHash     String    @db.VarChar(255) @map("otp_hash")
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  expiresAt   DateTime  @db.Timestamptz(6) @map("expires_at")
  consumedAt  DateTime? @db.Timestamptz(6) @map("consumed_at")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")

  @@index([identifier, consumedAt, expiresAt])
  @@map("auth_challenges")
}

// ============================================================================
// ELECTION MANAGEMENT MODELS (Models 9–11)
// ============================================================================

model Election {
  id                   String                    @id @db.VarChar(50) // e.g. "LS-2029"
  name                 String                    @db.VarChar(200)
  type                 ElectionType
  year                 Int
  stateId              String?                   @db.VarChar(10) @map("state_id") // Null for Lok Sabha; Required for State Assembly
  status               ElectionStatus            @default(UPCOMING)
  registrationDeadline DateTime?                 @db.Date @map("registration_deadline")
  nominationStartDate  DateTime?                 @db.Date @map("nomination_start_date")
  nominationEndDate    DateTime?                 @db.Date @map("nomination_end_date")
  scrutinyDate         DateTime?                 @db.Date @map("scrutiny_date")
  withdrawalDeadline   DateTime?                 @db.Date @map("withdrawal_deadline")
  campaignStartDate    DateTime?                 @db.Date @map("campaign_start_date")
  campaignEndDate      DateTime?                 @db.Date @map("campaign_end_date")
  pollingStartDate     DateTime                  @db.Date @map("polling_start_date")
  pollingEndDate       DateTime                  @db.Date @map("polling_end_date")
  countingDate         DateTime                  @db.Date @map("counting_date")
  resultDate           DateTime                  @db.Date @map("result_date")
  simulationClockDate  DateTime?                 @db.Date @map("simulation_clock_date")
  demoSandboxMode      String                    @default("CONCURRENT_SIMULATION_SANDBOX") @db.VarChar(50) @map("demo_sandbox_mode")
  description          String                    @default("") @db.Text
  country              String                    @default("India") @db.VarChar(100)
  targetJurisdiction   String                    @default("National") @db.VarChar(150) @map("target_jurisdiction")
  version              Int                       @default(1)
  metadataSource       MetadataSource            @default(DEMO_SAMPLE) @map("metadata_source")
  createdByAdminId     String?                   @db.Uuid @map("created_by_admin_id")
  updatedByAdminId     String?                   @db.Uuid @map("updated_by_admin_id")
  cancelledAt          DateTime?                 @db.Timestamptz(6) @map("cancelled_at")
  cancelledByAdminId   String?                   @db.Uuid @map("cancelled_by_admin_id")
  cancellationReason   String?                   @db.Text @map("cancellation_reason")
  archivedAt           DateTime?                 @db.Timestamptz(6) @map("archived_at")
  archivedByAdminId    String?                   @db.Uuid @map("archived_by_admin_id")
  archiveNote          String?                   @db.Text @map("archive_note")
  createdAt            DateTime                  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt            DateTime                  @updatedAt @db.Timestamptz(6) @map("updated_at")

  state                State?                    @relation(fields: [stateId], references: [id], onDelete: Restrict)
  createdByAdmin       AdminUser?                @relation("ElectionCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  updatedByAdmin       AdminUser?                @relation("ElectionUpdater", fields: [updatedByAdminId], references: [id], onDelete: SetNull)
  cancelledByAdmin     AdminUser?                @relation("ElectionCanceller", fields: [cancelledByAdminId], references: [id], onDelete: SetNull)
  archivedByAdmin      AdminUser?                @relation("ElectionArchiver", fields: [archivedByAdminId], references: [id], onDelete: SetNull)
  constituencyMappings ElectionConstituency[]
  lifecycleHistory     ElectionLifecycleHistory[]
  candidateNominations CandidateNomination[]
  demoParticipations   DemoParticipation[]
  countingSessions     CountingSession[]
  announcements           Announcement[]
  adminScopes             AdminElectionScope[]
  adminConstituencyScopes AdminConstituencyScope[]

  @@index([status, type])
  @@index([stateId, status])
  @@map("elections")
}

model ElectionConstituency {
  id                          String                     @id @default(uuid()) @db.Uuid
  electionId                  String                     @db.VarChar(50) @map("election_id")
  constituencyType            ConstituencyType           @map("constituency_type")
  parliamentaryConstituencyId String?                    @db.VarChar(50) @map("parliamentary_constituency_id")
  assemblyConstituencyId      String?                    @db.VarChar(50) @map("assembly_constituency_id")
  createdAt                   DateTime                   @default(now()) @db.Timestamptz(6) @map("created_at")

  election                    Election                   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  parliamentaryConstituency   ParliamentaryConstituency? @relation(fields: [parliamentaryConstituencyId], references: [id], onDelete: Cascade)
  assemblyConstituency        AssemblyConstituency?      @relation(fields: [assemblyConstituencyId], references: [id], onDelete: Cascade)

  // NOTE: Partial unique indexes uq_election_constituency_pc and uq_election_constituency_ac
  // are created via custom SQL migrations to prevent duplicates with NULLs.
  @@index([electionId, constituencyType])
  @@index([parliamentaryConstituencyId])
  @@index([assemblyConstituencyId])
  @@map("election_constituencies")
}

model ElectionLifecycleHistory {
  id                String         @id @default(uuid()) @db.Uuid
  electionId        String         @db.VarChar(50) @map("election_id")
  action            String         @default("STATUS_TRANSITION") @db.VarChar(60)
  fromStatus        ElectionStatus @map("from_status")
  toStatus          ElectionStatus @map("to_status")
  changedByAdminId  String?        @db.Uuid @map("changed_by_admin_id")
  changedAt         DateTime       @default(now()) @db.Timestamptz(6) @map("changed_at")
  note              String         @default("") @db.Text
  requestId         String?        @db.VarChar(100) @map("request_id")
  metadata          Json           @default("{}")

  election          Election       @relation(fields: [electionId], references: [id], onDelete: Cascade)
  changedByAdmin    AdminUser?     @relation(fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([electionId, changedAt])
  @@map("election_lifecycle_history")
}

// ============================================================================
// PARTIES & CANDIDATE MODELS (Models 12–14)
// ============================================================================

model PoliticalParty {
  id              String            @id @db.VarChar(50) // e.g. "PARTY-BJP"
  name            String            @db.VarChar(150)
  abbreviation    String            @db.VarChar(20)
  partyType       PartyType         @default(NATIONAL) @map("party_type")
  symbolName      String            @db.VarChar(100) @map("symbol_name")
  symbolUrl       String            @db.VarChar(500) @map("symbol_url")
  description     String            @default("") @db.Text
  establishedYear Int?              @map("established_year")
  headquarters    String?           @db.VarChar(150)
  status          PartyStatus       @default(ACTIVE)
  metadataSource  MetadataSource    @default(DEMO_SAMPLE) @map("metadata_source")
  createdAt       DateTime          @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6) @map("updated_at")

  candidates      Candidate[]
  nominations     CandidateNomination[]
  candidateTallies CandidateTally[]

  @@map("political_parties")
}

model Candidate {
  id                  String                @id @db.VarChar(50) // e.g. "CAND-LS29-KRN-1"
  partyId             String                @db.VarChar(50) @map("party_id")
  displayName         String?               @db.VarChar(150) @map("display_name")
  fullName            String                @db.VarChar(150) @map("full_name")
  age                 Int
  gender              String                @db.VarChar(20)
  education           String                @db.VarChar(150)
  profession          String                @db.VarChar(150)
  criminalCases       Int                   @default(0) @map("criminal_cases")
  assetsDeclared      BigInt                @default(0) @map("assets_declared")
  liabilitiesDeclared BigInt                @default(0) @map("liabilities_declared")
  photoUrl            String?               @db.VarChar(500) @map("photo_url")
  bio                 String                @default("") @db.Text
  isActive            Boolean               @default(true) @map("is_active")
  deactivatedAt       DateTime?             @db.Timestamptz(6) @map("deactivated_at")
  metadataSource      MetadataSource        @default(DEMO_SAMPLE) @map("metadata_source")
  createdAt           DateTime              @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6) @map("updated_at")

  party               PoliticalParty        @relation(fields: [partyId], references: [id], onDelete: Restrict)
  nominations         CandidateNomination[]
  tallies             CandidateTally[]
  winningSessions     CountingSession[]     @relation("WinnerCandidate")
  runnerUpSessions    CountingSession[]     @relation("RunnerUpCandidate")
  leadingRounds       CountingRound[]       @relation("LeadingCandidate")
  tieResolutionsWon   TieResolution[]       @relation("TieResolutionWinner")

  @@unique([id, partyId]) // Composite key guaranteeing party consistency in tallies
  @@index([partyId])
  @@index([isActive])
  @@map("candidates")
}

model CandidateNomination {
  id                          String                    @id @default(uuid()) @db.Uuid
  candidateId                 String                    @db.VarChar(50) @map("candidate_id")
  partyId                     String?                   @db.VarChar(50) @map("party_id") // Null for independent candidates
  isIndependent               Boolean                   @default(false) @map("is_independent")
  partyNameSnapshot           String?                   @db.VarChar(150) @map("party_name_snapshot")
  partyAbbreviationSnapshot   String?                   @db.VarChar(20) @map("party_abbreviation_snapshot")
  partyTypeSnapshot           PartyType?                @map("party_type_snapshot")
  electionId                  String                    @db.VarChar(50) @map("election_id")
  constituencyType            ConstituencyType          @map("constituency_type")
  parliamentaryConstituencyId String?                   @db.VarChar(50) @map("parliamentary_constituency_id")
  assemblyConstituencyId      String?                   @db.VarChar(50) @map("assembly_constituency_id")
  nominationDate              DateTime                  @default(now()) @db.Timestamptz(6) @map("nomination_date")
  status                      CandidateNominationStatus @default(APPROVED)
  version                     Int                       @default(1)
  submittedAt                 DateTime?                 @db.Timestamptz(6) @map("submitted_at")
  submittedByAdminId          String?                   @db.Uuid @map("submitted_by_admin_id")
  scrutinyNote                String                    @default("") @db.Text @map("scrutiny_note")
  scrutinyDate                DateTime?                 @db.Timestamptz(6) @map("scrutiny_date")
  scrutinizedByAdminId        String?                   @db.Uuid @map("scrutinized_by_admin_id")
  decisionAt                  DateTime?                 @db.Timestamptz(6) @map("decision_at")
  decisionReason              String?                   @db.Text @map("decision_reason")
  withdrawnAt                 DateTime?                 @db.Timestamptz(6) @map("withdrawn_at")
  withdrawnByAdminId          String?                   @db.Uuid @map("withdrawn_by_admin_id")
  withdrawalReason            String?                   @db.Text @map("withdrawal_reason")
  createdByAdminId            String?                   @db.Uuid @map("created_by_admin_id")
  createdAt                   DateTime                  @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                   DateTime                  @updatedAt @db.Timestamptz(6) @map("updated_at")

  candidate                   Candidate                 @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  party                       PoliticalParty?           @relation(fields: [partyId], references: [id], onDelete: Restrict)
  election                    Election                  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  parliamentaryConstituency   ParliamentaryConstituency? @relation(fields: [parliamentaryConstituencyId], references: [id], onDelete: Cascade)
  assemblyConstituency        AssemblyConstituency?     @relation(fields: [assemblyConstituencyId], references: [id], onDelete: Cascade)
  createdByAdmin              AdminUser?                @relation("NominationCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  submittedByAdmin            AdminUser?                @relation("NominationSubmitter", fields: [submittedByAdminId], references: [id], onDelete: SetNull)
  scrutinizedByAdmin          AdminUser?                @relation(fields: [scrutinizedByAdminId], references: [id], onDelete: SetNull)
  withdrawnByAdmin            AdminUser?                @relation("NominationWithdrawer", fields: [withdrawnByAdminId], references: [id], onDelete: SetNull)
  tallies                     CandidateTally[]
  lifecycleHistory            NominationLifecycleHistory[]

  // NOTE: Candidates may contest multiple constituencies in an election (simulated up to 2 constituencies).
  // Per-constituency uniqueness is enforced via PostgreSQL partial unique indexes:
  // uq_nomination_candidate_pc and uq_nomination_candidate_ac.
  @@unique([id, candidateId, partyId]) // Composite key for historical party tally integrity
  @@index([candidateId, electionId])
  @@index([partyId])
  @@index([electionId, status])
  @@index([parliamentaryConstituencyId])
  @@index([assemblyConstituencyId])
  @@map("candidate_nominations")
}

model NominationLifecycleHistory {
  id               String                    @id @default(uuid()) @db.Uuid
  nominationId     String                    @db.Uuid @map("nomination_id")
  action           String                    @db.VarChar(60)
  fromStatus       CandidateNominationStatus @map("from_status")
  toStatus         CandidateNominationStatus @map("to_status")
  changedByAdminId String?                   @db.Uuid @map("changed_by_admin_id")
  changedAt        DateTime                  @default(now()) @db.Timestamptz(6) @map("changed_at")
  note             String                    @default("") @db.Text
  requestId        String?                   @db.VarChar(100) @map("request_id")
  metadata         Json                      @default("{}")

  nomination       CandidateNomination       @relation(fields: [nominationId], references: [id], onDelete: Cascade)
  changedByAdmin   AdminUser?                @relation("NominationHistoryActor", fields: [changedByAdminId], references: [id], onDelete: SetNull)

  @@index([nominationId, changedAt])
  @@map("nomination_lifecycle_history")
}

// ============================================================================
// ADMINISTRATIVE RBAC, SCOPING & AUDIT MODELS
// ============================================================================

model AdminUser {
  id                    String                     @id @default(uuid()) @db.Uuid
  userId                String                     @unique @db.Uuid @map("user_id")
  officerCode           String                     @unique @db.VarChar(50) @map("officer_code") // e.g. "ECI-SUPER-001"
  email                 String                     @unique @db.VarChar(255)
  fullName              String                     @db.VarChar(150) @map("full_name")
  designation           String                     @db.VarChar(150)
  role                  AdminRole                  @default(READ_ONLY_AUDITOR)
  status                AdminStatus                @default(ACTIVE)
  assignedStateId       String?                    @db.VarChar(10) @map("assigned_state_id")
  isActive              Boolean                    @default(true) @map("is_active")
  suspendedAt           DateTime?                  @db.Timestamptz(6) @map("suspended_at")
  suspendedReason       String?                    @db.Text @map("suspended_reason")
  deactivatedAt         DateTime?                  @db.Timestamptz(6) @map("deactivated_at")
  createdByAdminId      String?                    @db.Uuid @map("created_by_admin_id")
  passwordUpdatedAt     DateTime?                  @db.Timestamptz(6) @map("password_updated_at")
  createdAt             DateTime                   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt             DateTime                   @updatedAt @db.Timestamptz(6) @map("updated_at")

  user                        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedState               State?                     @relation(fields: [assignedStateId], references: [id], onDelete: Restrict)
  createdByAdmin              AdminUser?                 @relation("AdminProvisioner", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  provisionedAdmins           AdminUser[]                @relation("AdminProvisioner")
  assignedStateScopes         AdminStateScope[]          @relation("StateScopedAdmin")
  delegatedStateScopes        AdminStateScope[]          @relation("StateScopeDelegator")
  assignedElectionScopes      AdminElectionScope[]       @relation("ScopedAdmin")
  delegatedScopes             AdminElectionScope[]       @relation("ScopeDelegator")
  assignedConstituencyScopes  AdminConstituencyScope[]   @relation("ConstituencyScopedAdmin")
  delegatedConstituencyScopes AdminConstituencyScope[]   @relation("ConstituencyScopeDelegator")
  actionLogs                  AdminActionLog[]
  lifecycleChanges            ElectionLifecycleHistory[]
  createdElections            Election[]                 @relation("ElectionCreator")
  updatedElections            Election[]                 @relation("ElectionUpdater")
  cancelledElections          Election[]                 @relation("ElectionCanceller")
  archivedElections           Election[]                 @relation("ElectionArchiver")
  scrutinizedNominations      CandidateNomination[]
  createdNominations          CandidateNomination[]      @relation("NominationCreator")
  submittedNominations        CandidateNomination[]      @relation("NominationSubmitter")
  withdrawnNominations        CandidateNomination[]      @relation("NominationWithdrawer")
  nominationHistoryChanges    NominationLifecycleHistory[] @relation("NominationHistoryActor")
  publishedSessions           CountingSession[]          @relation("SessionPublisher")
  processedRounds             CountingRound[]            @relation("RoundProcessor")
  correctedSessions           ResultCorrectionHistory[]  @relation("SessionCorrector")
  approvedTieResolutions      TieResolution[]            @relation("TieResolutionApprover")
  createdAnnouncements        Announcement[]             @relation("AnnouncementCreator")

  @@index([role, status])
  @@index([assignedStateId])
  @@map("admin_users")
}

model AdminStateScope {
  id                String     @id @default(uuid()) @db.Uuid
  adminUserId       String     @db.Uuid @map("admin_user_id")
  stateId           String     @db.VarChar(10) @map("state_id")
  assignedAt        DateTime   @default(now()) @db.Timestamptz(6) @map("assigned_at")
  assignedByAdminId String?    @db.Uuid @map("assigned_by_admin_id")

  adminUser         AdminUser  @relation("StateScopedAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  state             State      @relation(fields: [stateId], references: [id], onDelete: Restrict)
  assignedByAdmin   AdminUser? @relation("StateScopeDelegator", fields: [assignedByAdminId], references: [id], onDelete: SetNull)

  @@unique([adminUserId, stateId])
  @@index([adminUserId])
  @@index([stateId])
  @@map("admin_state_scopes")
}

model AdminElectionScope {
  id                 String     @id @default(uuid()) @db.Uuid
  adminUserId        String     @db.Uuid @map("admin_user_id")
  electionId         String     @db.VarChar(50) @map("election_id")
  assignedAt         DateTime   @default(now()) @db.Timestamptz(6) @map("assigned_at")
  assignedByAdminId  String?    @db.Uuid @map("assigned_by_admin_id")

  adminUser          AdminUser  @relation("ScopedAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  election           Election   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  assignedByAdmin    AdminUser? @relation("ScopeDelegator", fields: [assignedByAdminId], references: [id], onDelete: SetNull)

  @@unique([adminUserId, electionId])
  @@index([adminUserId])
  @@index([electionId])
  @@map("admin_election_scopes")
}

model AdminConstituencyScope {
  id                          String                     @id @default(uuid()) @db.Uuid
  adminUserId                 String                     @db.Uuid @map("admin_user_id")
  electionId                  String?                    @db.VarChar(50) @map("election_id")
  constituencyType            ConstituencyType           @map("constituency_type")
  parliamentaryConstituencyId String?                    @db.VarChar(50) @map("parliamentary_constituency_id")
  assemblyConstituencyId      String?                    @db.VarChar(50) @map("assembly_constituency_id")
  assignedAt                  DateTime                   @default(now()) @db.Timestamptz(6) @map("assigned_at")
  assignedByAdminId           String?                    @db.Uuid @map("assigned_by_admin_id")

  adminUser                 AdminUser                  @relation("ConstituencyScopedAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  election                  Election?                  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  parliamentaryConstituency ParliamentaryConstituency? @relation(fields: [parliamentaryConstituencyId], references: [id], onDelete: Cascade)
  assemblyConstituency      AssemblyConstituency?      @relation(fields: [assemblyConstituencyId], references: [id], onDelete: Cascade)
  assignedByAdmin           AdminUser?                 @relation("ConstituencyScopeDelegator", fields: [assignedByAdminId], references: [id], onDelete: SetNull)

  @@index([adminUserId])
  @@index([electionId])
  @@index([parliamentaryConstituencyId])
  @@index([assemblyConstituencyId])
  @@map("admin_constituency_scopes")
}

model AdminActionLog {
  id              String     @id @default(uuid()) @db.Uuid
  adminUserId     String?    @db.Uuid @map("admin_user_id")
  actorUserId     String?    @db.Uuid @map("actor_user_id")
  actorIdentifier String?    @db.VarChar(100) @map("actor_identifier")
  actorRole       AdminRole? @map("actor_role")
  actionType      String     @db.VarChar(50) @map("action_type")
  domain          String     @db.VarChar(50)
  targetEntityId  String     @db.VarChar(100) @map("target_entity_id")
  outcome         String     @default("SUCCESS") @db.VarChar(20)
  requestId       String?    @db.VarChar(100) @map("request_id")
  userAgent       String?    @db.Text @map("user_agent")
  details         Json       @default("{}")
  ipAddress       String?    @db.VarChar(45) @map("ip_address")
  timestamp       DateTime   @default(now()) @db.Timestamptz(6)

  adminUser       AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([domain, targetEntityId, timestamp])
  @@index([adminUserId, timestamp])
  @@index([outcome, timestamp])
  @@map("admin_action_logs")
}

// ============================================================================
// DEMO PARTICIPATION (STRICT ZERO-CHOICE PRIVACY) (Model 18)
// ============================================================================

model DemoParticipation {
  id            String              @id @default(uuid()) @db.Uuid
  voterId       String              @db.Uuid @map("voter_id")
  electionId    String              @db.VarChar(50) @map("election_id")
  status        ParticipationStatus @default(VOTED)
  demoReference String              @db.VarChar(30) @map("demo_reference") // e.g. "DEMO-LS-000001"
  referenceId   String              @db.VarChar(60) @map("reference_id") // e.g. "DEMO-REF-LS2029-VOTER001"
  participatedAt DateTime           @db.Timestamptz(6) @map("participated_at") // Centralized demo clock timestamp
  recordedAt    DateTime            @default(now()) @db.Timestamptz(6) @map("recorded_at") // Host wall-clock timestamp
  metadata      Json                @default("{}")

  voter         VoterProfile        @relation(fields: [voterId], references: [id], onDelete: Cascade)
  election      Election            @relation(fields: [electionId], references: [id], onDelete: Cascade)

  // STRICT INVARIANT: Exactly one participation record per voter per election.
  // STRICT INVARIANT: ZERO candidate or party columns exist in this table!
  @@unique([voterId, electionId])
  @@index([voterId, electionId])
  @@map("demo_participations")
}

// ============================================================================
// COUNTING SIMULATION & RESULTS (INDEPENDENT DATASET) (Models 19–25)
// ============================================================================

model CountingSession {
  id                          String                     @id @db.VarChar(100) // e.g. "RESULT-LS-2029-WB-PC-KOLKATA-SOUTH"
  electionId                  String                     @db.VarChar(50) @map("election_id")
  constituencyType            ConstituencyType           @map("constituency_type")
  parliamentaryConstituencyId String?                    @db.VarChar(50) @map("parliamentary_constituency_id")
  assemblyConstituencyId      String?                    @db.VarChar(50) @map("assembly_constituency_id")
  totalConfiguredRounds       Int                        @default(5) @map("total_configured_rounds")
  currentRound                Int                        @default(0) @map("current_round")
  status                      ResultStatus               @default(DRAFT)
  totalVoters                 Int                        @map("total_voters")
  totalCountedVotes           Int                        @default(0) @map("total_counted_votes")
  notaVotes                   Int                        @default(0) @map("nota_votes")
  rejectedVotes               Int                        @default(0) @map("rejected_votes")
  winnerCandidateId           String?                    @db.VarChar(50) @map("winner_candidate_id")
  runnerUpCandidateId         String?                    @db.VarChar(50) @map("runner_up_candidate_id")
  victoryMargin               Int                        @default(0) @map("victory_margin")
  isPublished                 Boolean                    @default(false) @map("is_published")
  publishedAt                 DateTime?                  @db.Timestamptz(6) @map("published_at")
  publishedByAdminId          String?                    @db.Uuid @map("published_by_admin_id")
  createdAt                   DateTime                   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                   DateTime                   @updatedAt @db.Timestamptz(6) @map("updated_at")

  election                    Election                   @relation(fields: [electionId], references: [id], onDelete: Cascade)
  parliamentaryConstituency   ParliamentaryConstituency? @relation(fields: [parliamentaryConstituencyId], references: [id], onDelete: Cascade)
  assemblyConstituency        AssemblyConstituency?      @relation(fields: [assemblyConstituencyId], references: [id], onDelete: Cascade)
  winnerCandidate             Candidate?                 @relation("WinnerCandidate", fields: [winnerCandidateId], references: [id], onDelete: SetNull)
  runnerUpCandidate           Candidate?                 @relation("RunnerUpCandidate", fields: [runnerUpCandidateId], references: [id], onDelete: SetNull)
  publishedByAdmin            AdminUser?                 @relation("SessionPublisher", fields: [publishedByAdminId], references: [id], onDelete: SetNull)
  rounds                      CountingRound[]
  tallies                     CandidateTally[]
  corrections                 ResultCorrectionHistory[]
  tieResolution               TieResolution?

  // NOTE: Partial unique indexes uq_counting_session_pc and uq_counting_session_ac
  // are created via custom SQL migrations to prevent duplicates with NULLs.
  @@index([isPublished, electionId])
  @@index([electionId, constituencyType])
  @@map("counting_sessions")
}

model CountingRound {
  id                 String          @id @default(uuid()) @db.Uuid
  sessionId          String          @db.VarChar(100) @map("session_id")
  roundNumber        Int             @map("round_number")
  roundVotes         Int             @default(0) @map("round_votes")
  cumulativeVotes    Int             @default(0) @map("cumulative_votes")
  leadingCandidateId String?         @db.VarChar(50) @map("leading_candidate_id")
  leadMargin         Int             @default(0) @map("lead_margin")
  processedAt        DateTime        @default(now()) @db.Timestamptz(6) @map("processed_at")
  processedByAdminId String?         @db.Uuid @map("processed_by_admin_id")

  session            CountingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  leadingCandidate   Candidate?      @relation("LeadingCandidate", fields: [leadingCandidateId], references: [id], onDelete: SetNull)
  processedByAdmin   AdminUser?      @relation("RoundProcessor", fields: [processedByAdminId], references: [id], onDelete: SetNull)

  @@unique([sessionId, roundNumber])
  @@index([sessionId, roundNumber])
  @@map("counting_rounds")
}

model CandidateTally {
  id                  String               @id @default(uuid()) @db.Uuid
  sessionId           String               @db.VarChar(100) @map("session_id")
  candidateId         String               @db.VarChar(50) @map("candidate_id")
  nominationId        String?              @db.Uuid @map("nomination_id")
  partyId             String?              @db.VarChar(50) @map("party_id") // Nullable for independent candidates
  votes               Int                  @default(0)
  voteSharePercentage Decimal              @default(0.00) @db.Decimal(5, 2) @map("vote_share_percentage")
  createdAt           DateTime             @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6) @map("updated_at")

  session             CountingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  candidate           Candidate            @relation(fields: [candidateId], references: [id], onDelete: Restrict)
  nomination          CandidateNomination? @relation(fields: [nominationId], references: [id], onDelete: Restrict)
  party               PoliticalParty?      @relation(fields: [partyId], references: [id], onDelete: Restrict)

  @@unique([sessionId, candidateId])
  @@index([sessionId])
  @@index([nominationId])
  @@map("candidate_tallies")
}

model ResultCorrectionHistory {
  id                 String          @id @default(uuid()) @db.Uuid
  sessionId          String          @db.VarChar(100) @map("session_id")
  previousState      Json            @map("previous_state")
  correctedState     Json            @map("corrected_state")
  reason             String          @db.Text
  correctedByAdminId String          @db.Uuid @map("corrected_by_admin_id")
  correctedAt        DateTime        @default(now()) @db.Timestamptz(6) @map("corrected_at")

  session            CountingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  correctedByAdmin   AdminUser       @relation("SessionCorrector", fields: [correctedByAdminId], references: [id], onDelete: Restrict)

  @@index([sessionId, correctedAt])
  @@map("result_correction_history")
}

model TieResolution {
  id                String          @id @default(uuid()) @db.Uuid
  sessionId         String          @unique @db.VarChar(100) @map("session_id")
  decision          String          @db.VarChar(100)
  selectedWinnerId  String          @db.VarChar(50) @map("selected_winner_id")
  resolutionMethod  String          @db.VarChar(100) @map("resolution_method")
  justificationNote String          @db.Text @map("justification_note")
  approvedByAdminId String          @db.Uuid @map("approved_by_admin_id")
  resolvedAt        DateTime        @default(now()) @db.Timestamptz(6) @map("resolved_at")

  // Consistent referential policy: onDelete: Restrict preserves immutable tie-resolution evidence
  // and blocks deletion of a CountingSession that has a tie-resolution record.
  session           CountingSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  selectedWinner    Candidate       @relation("TieResolutionWinner", fields: [selectedWinnerId], references: [id], onDelete: Restrict)
  approvedByAdmin   AdminUser       @relation("TieResolutionApprover", fields: [approvedByAdminId], references: [id], onDelete: Restrict)

  @@index([selectedWinnerId])
  @@index([approvedByAdminId])
  @@map("tie_resolutions")
}

// ============================================================================
// ANNOUNCEMENTS & NOTIFICATIONS (Models 23–25)
// ============================================================================

model Announcement {
  id                               String                     @id @db.VarChar(50) // e.g. "ANN-001"
  title                            String                     @db.VarChar(200)
  summary                          String                     @db.Text
  message                          String                     @db.Text
  category                         AnnouncementCategory       @default(GENERAL_INFO)
  targetAudience                   AnnouncementAudience       @default(ALL_VOTERS) @map("target_audience")
  targetStateId                    String?                    @db.VarChar(10) @map("target_state_id")
  targetElectionId                 String?                    @db.VarChar(50) @map("target_election_id")
  targetConstituencyType           ConstituencyType?          @map("target_constituency_type")
  targetParliamentaryConstituencyId String?                   @db.VarChar(50) @map("target_parliamentary_constituency_id")
  targetAssemblyConstituencyId     String?                    @db.VarChar(50) @map("target_assembly_constituency_id")
  publicationDate                  DateTime                   @db.Date @map("publication_date")
  expiryDate                       DateTime                   @db.Date @map("expiry_date")
  status                           AnnouncementStatus         @default(PUBLISHED)
  createdByAdminId                 String?                    @db.Uuid @map("created_by_admin_id")
  createdAt                        DateTime                   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt                        DateTime                   @updatedAt @db.Timestamptz(6) @map("updated_at")

  targetState                      State?                     @relation(fields: [targetStateId], references: [id], onDelete: SetNull)
  targetElection                   Election?                  @relation(fields: [targetElectionId], references: [id], onDelete: SetNull)
  targetParliamentaryConstituency  ParliamentaryConstituency? @relation(fields: [targetParliamentaryConstituencyId], references: [id], onDelete: SetNull)
  targetAssemblyConstituency       AssemblyConstituency?      @relation(fields: [targetAssemblyConstituencyId], references: [id], onDelete: SetNull)
  createdByAdmin                   AdminUser?                 @relation("AnnouncementCreator", fields: [createdByAdminId], references: [id], onDelete: SetNull)

  @@index([status, targetAudience, publicationDate])
  @@map("announcements")
}

model VoterNotification {
  id        String           @id @db.VarChar(50) // e.g. "NOTIF-001"
  voterId   String           @db.Uuid @map("voter_id")
  type      NotificationType @default(GENERAL_ANNOUNCEMENT)
  title     String           @db.VarChar(200)
  message   String           @db.Text
  timestamp DateTime         @default(now()) @db.Timestamptz(6)
  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @db.Timestamptz(6) @map("read_at")

  voter     VoterProfile     @relation(fields: [voterId], references: [id], onDelete: Cascade)

  @@index([voterId, isRead])
  @@map("voter_notifications")
}
