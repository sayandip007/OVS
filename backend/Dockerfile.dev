# ==============================================================================
# OVS Backend — Development Node.js 22 Alpine Dockerfile
# ==============================================================================
# Retains full development dependencies (tsx, typescript, @types/*, prisma CLI)
# Enables source-code hot reloading and local development tooling
FROM node:22.12.0-alpine
WORKDIR /app
RUN apk add --no-cache openssl libc6-compat wget

COPY package.json package-lock.json ./
COPY prisma ./prisma/
RUN npm ci
RUN npx prisma generate --schema=prisma/schema.prisma

EXPOSE 5000

CMD ["npm", "run", "dev"]
