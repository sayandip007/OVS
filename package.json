{
  "name": "online-voting-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test:unit": "node --import ./tests/loader.mjs --test tests/electionArchitecture.test.mjs",
    "test:architecture": "node --import ./tests/loader.mjs --test tests/architectureConsistency.test.mjs",
    "test": "node --import ./tests/loader.mjs --test tests/electionArchitecture.test.mjs && node --import ./tests/loader.mjs --test tests/architectureConsistency.test.mjs",
    "test:e2e": "playwright test",
    "backend:dev": "tsx watch backend/src/server.ts",
    "backend:build": "tsc -p backend/tsconfig.build.json",
    "backend:typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "backend:lint": "tsc -p backend/tsconfig.json --noEmit",
    "backend:test:unit": "node --import tsx --test backend/tests/unit/*.test.ts",
    "backend:test:integration": "node --import tsx --test backend/tests/integration/api.integration.test.ts",
    "backend:test": "npm run backend:test:unit && npm run backend:test:integration",
    "prisma:validate": "prisma validate --schema=backend/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=backend/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema=backend/prisma/schema.prisma",
    "prisma:seed": "tsx backend/prisma/seed.ts",
    "import:candidates": "node scripts/process-real-candidates.mjs",
    "db:import-candidates": "node --import tsx scripts/import-candidates-to-db.ts",
    "backend:admin:bootstrap": "tsx backend/src/modules/admin/bootstrapSuperAdmin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.4.1",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "5.1.0",
    "express-rate-limit": "7.5.0",
    "helmet": "8.1.0",
    "lucide-react": "^0.546.0",
    "pino": "9.6.0",
    "pino-http": "10.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.5.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.51.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "2.8.17",
    "@types/express": "5.0.0",
    "@types/node": "22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@types/supertest": "6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "postcss": "^8.5.3",
    "prisma": "6.4.1",
    "supertest": "7.0.0",
    "tailwindcss": "^4.3.4",
    "tsx": "4.19.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
