# ==============================================================================
# OVS Frontend — Production Multi-Stage Dockerfile (Vite + Nginx)
# ==============================================================================
# Stage 1: Build static assets using Node.js 22 Alpine
FROM node:22.12.0-alpine AS builder
WORKDIR /app

# Build arguments for compile-time environment variables
ARG VITE_API_BASE_URL=/api/v1
ARG VITE_DATA_SOURCE_MODE=BACKEND_API

ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ENV VITE_DATA_SOURCE_MODE=${VITE_DATA_SOURCE_MODE}

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then npm ci; else npm install; fi

# Copy application source code and configuration
COPY tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts index.html ./
COPY public ./public/
COPY src ./src/

# Compile frontend bundle to /app/dist
RUN npm run build

# Stage 2: Serve static bundle via hardened Nginx Alpine
FROM nginx:1.27-alpine AS runner

# Remove default nginx static html files
RUN rm -rf /usr/share/nginx/html/*

# Copy custom reverse-proxy and security configuration
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Expose HTTP port 80
EXPOSE 80

# Health check against internal Nginx health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:80/nginx-health || exit 1

CMD ["nginx", "-g", "daemon off;"]
