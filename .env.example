# ==============================================================================
# Online Voting System (OVS) — Root Environment Configuration Template
# Phase 8.2: Backend Foundation & Dual-Mode Frontend Configuration
# (Safe placeholders only — NEVER commit real production secrets)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend Configuration (Vite / React 19 SPA on Port 3000)
# ------------------------------------------------------------------------------
# Data source mode: LOCAL_DEMO (default, browser localStorage) | BACKEND_API
VITE_DATA_SOURCE_MODE=LOCAL_DEMO
VITE_API_BASE_URL=http://localhost:5000/api/v1

# ------------------------------------------------------------------------------
# 2. Backend Server Configuration (Express 5 + Prisma 6 on Port 5000)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
CLIENT_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. PostgreSQL 16 Database Configuration (Port 5432)
# ------------------------------------------------------------------------------
POSTGRES_USER=ovs_admin
POSTGRES_PASSWORD=ovs_secret_dev
POSTGRES_DB=ovs_db
DATABASE_URL=postgresql://ovs_admin:ovs_secret_dev@localhost:5432/ovs_db?schema=public

# ------------------------------------------------------------------------------
# 4. Session & Security Configuration
# ------------------------------------------------------------------------------
# Must be at least 32 characters long; placeholder values are rejected in production
SESSION_SECRET=dev_session_secret_32_characters_long_min

# ------------------------------------------------------------------------------
# 5. Optional Backing Services (Reserved for Phase 8.3+ Sessions/Rate-Limiting)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
